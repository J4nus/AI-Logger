{
  "manifest_version": 3,
  "name": "AI Activity Logger",
  "description": "Loguje veškerou AI aktivitu napříč Chromium prohlížečem a modely.",
  "version": "1.0.0",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.mistral.ai/*",
    "https://*.openai.com/*",
    "https://*.anthropic.com/*",
    "https://*.deepseek.com/*",
    "https://*.perplexity.ai/*",
    "https://*.copilot.microsoft.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://chat.mistral.ai/*",
        "https://*.openai.com/*",
        "https://*.anthropic.com/*",
        "https://*.deepseek.com/*",
        "https://*.perplexity.ai/*",
        "https://*.copilot.microsoft.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
